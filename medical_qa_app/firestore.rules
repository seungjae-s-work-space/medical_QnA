rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 헬퍼 함수
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // users 컬렉션
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // conversations 컬렉션
    match /conversations/{conversationId} {
      // 읽기: 인증된 사용자이고, 관리자이거나 본인 대화방인 경우
      // 문서가 존재하지 않을 경우에도 허용 (생성 전 확인용)
      allow read: if isAuthenticated() &&
                     (isAdmin() || conversationId == 'user_' + request.auth.uid);
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() &&
                       (isAdmin() || resource.data.userId == request.auth.uid);
      allow delete: if isAdmin();

      // messages 서브컬렉션
      match /messages/{messageId} {
        allow read: if isAuthenticated() &&
                       (isAdmin() ||
                        get(/databases/$(database)/documents/conversations/$(conversationId)).data.userId == request.auth.uid);
        allow create: if isAuthenticated();
        allow update: if isAuthenticated();
        allow delete: if isAdmin();
      }
    }

    // encyclopedia 컬렉션 (난임백과)
    match /encyclopedia/{articleId} {
      // 읽기: 공개된 글은 인증된 사용자 모두, 비공개 글은 관리자만
      allow read: if isAuthenticated() &&
                     (resource.data.isPublished == true || isAdmin());
      // 생성/삭제: 관리자만
      allow create: if isAdmin();
      // 수정: 관리자이거나, 조회수만 증가시키는 경우 허용
      allow update: if isAdmin() ||
                       (isAuthenticated() &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewCount']) &&
                        request.resource.data.viewCount == resource.data.viewCount + 1);
      allow delete: if isAdmin();
    }

    // news 컬렉션 (난임&뉴스)
    match /news/{newsId} {
      // 읽기: 공개된 글은 인증된 사용자 모두, 비공개 글은 관리자만
      allow read: if isAuthenticated() &&
                     (resource.data.isPublished == true || isAdmin());
      // 생성/수정/삭제: 관리자만
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // notices 컬렉션 (공지사항)
    match /notices/{noticeId} {
      // 읽기: 공개된 글은 인증된 사용자 모두, 비공개 글은 관리자만
      allow read: if isAuthenticated() &&
                     (resource.data.isPublished == true || isAdmin());
      // 생성/수정/삭제: 관리자만
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // videos 컬렉션 (아기성공TV)
    match /videos/{videoId} {
      // 읽기: 공개된 글은 인증된 사용자 모두, 비공개 글은 관리자만
      allow read: if isAuthenticated() &&
                     (resource.data.isPublished == true || isAdmin());
      // 생성/수정/삭제: 관리자만
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
  }
}
