rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // 인증된 사용자만 접근 가능
    match /chat_images/{imageId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024  // 5MB 제한
                   && request.resource.contentType.matches('image/.*');
    }

    match /profile_images/{imageId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 2 * 1024 * 1024  // 2MB 제한
                   && request.resource.contentType.matches('image/.*');
    }

    // 난임백과 이미지 (관리자만 업로드 가능)
    match /encyclopedia_images/{imageId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024  // 10MB 제한
                   && request.resource.contentType.matches('image/.*');
    }

    // 뉴스 이미지
    match /news_images/{imageId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024  // 10MB 제한
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
