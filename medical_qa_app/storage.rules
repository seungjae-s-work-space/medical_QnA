rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated()
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isImageUnder(maxSize) {
      return request.resource.size < maxSize
        && request.resource.contentType.matches('image/(jpeg|png|gif|webp)');
    }

    // 채팅 이미지
    match /chat_images/{imageId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024  // 10MB 제한
                   && request.resource.contentType.matches('image/(jpeg|png|gif|webp)');
    }

    // 채팅 동영상
    match /chat_videos/{videoId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 100 * 1024 * 1024;  // 100MB 제한
    }

    // 채팅 파일 (PDF, 문서 등)
    match /chat_files/{fileId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 50 * 1024 * 1024;  // 50MB 제한
    }

    match /profile_images/{imageId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 2 * 1024 * 1024  // 2MB 제한
                   && request.resource.contentType.matches('image/(jpeg|png|gif|webp)');
    }

    // 난임백과 이미지 (관리자만 업로드 가능)
    match /encyclopedia_images/{imageId} {
      allow read: if request.auth != null;
      allow write: if isAdmin()
                   && isImageUnder(10 * 1024 * 1024);  // 10MB 제한
    }

    // 난임백과 썸네일
    match /encyclopedia_thumbnails/{imageId} {
      allow read: if request.auth != null;
      allow write: if isAdmin()
                   && isImageUnder(10 * 1024 * 1024);  // 10MB 제한
    }

    // 뉴스 이미지
    match /news_images/{imageId} {
      allow read: if request.auth != null;
      allow write: if isAdmin()
                   && isImageUnder(10 * 1024 * 1024);  // 10MB 제한
    }

    // 뉴스 썸네일
    match /news_thumbnails/{imageId} {
      allow read: if request.auth != null;
      allow write: if isAdmin()
                   && isImageUnder(10 * 1024 * 1024);  // 10MB 제한
    }

    // 홈 광고 배너 이미지 (비로그인 홈에도 노출되므로 공개 읽기)
    match /promotion_banners/{imageId} {
      allow read: if true;
      allow write: if isAdmin()
                   && isImageUnder(10 * 1024 * 1024);
    }

    // 홈 광고 상세 이미지 (비로그인 상세에도 노출되므로 공개 읽기)
    match /promotion_images/{imageId} {
      allow read: if true;
      allow write: if isAdmin()
                   && isImageUnder(10 * 1024 * 1024);
    }
  }
}
